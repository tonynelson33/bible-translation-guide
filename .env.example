# Copy this file to .env.local for local development, and add the same
# variables in your Vercel project's Settings -> Environment Variables for
# deployed environments.

# Supabase project backing the Church Finder (/church-finder). The table is
# read-only for this key (RLS restricts it to SELECT) — safe to expose to the
# browser. Without these two set, the Church Finder page shows a setup notice
# instead of the search form.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# No Bible-API keys are needed at runtime. /verses and /differences serve cached
# text (data/cachedVerses.json, data/differenceVerses.json).
# ESV_API_KEY (api.esv.org) and API_BIBLE_KEY (scripture.api.bible) are only used
# by one-off sourcing scripts — scripts/fetch-difference-verses.mjs and
# scripts/fetchVerseComparisons.mjs — when you need to (re)generate that text.

# Email notification (app/api/notify-submission) fired by a Postgres trigger
# every time someone submits a church correction, addition, closed report, or
# site correction — see the "add_church_suggestion_email_notification"
# migration. Without RESEND_API_KEY set, the route just logs and skips
# sending (submissions still save fine either way).
# Get a free key at resend.com — no domain verification needed, the route
# sends from Resend's shared onboarding@resend.dev sandbox address.
RESEND_API_KEY=
# Must exactly match the secret hardcoded in the trigger function (see the
# migration) — it's what lets the route trust a request actually came from
# this project's own database, not a random POST to a guessed URL.
SUBMISSION_WEBHOOK_SECRET=
