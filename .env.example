# Copy this file to .env.local for local development, and add the same
# variables in your Vercel project's Settings -> Environment Variables for
# deployed environments. None of these are required for the site to build or
# run — without them, the affected translations simply show "Text
# unavailable" on the /verses page. The comparison table on the home page
# never depends on these.

# Crossway ESV API (https://api.esv.org) — free for non-commercial use.
# Sign up for an account, create an API application, and get it approved to
# receive a key.
ESV_API_KEY=

# scripture.api.bible — free Starter-plan account. Powers NIV, NASB, and CSB
# by default (see data/translations.json). Note: the free Starter plan only
# allows 3 copyrighted translations active at once, so if you want to swap
# in NLT or NKJV instead, update apiBibleId in data/translations.json to
# match and drop one of the other three.
API_BIBLE_KEY=

# No key needed for KJV (bible-api.com) or NET (labs.bible.org) — those work
# out of the box. LSB has no known free public API as of mid-2026.

# Supabase project backing the Church Finder (/church-finder). The table is
# read-only for this key (RLS restricts it to SELECT) — safe to expose to the
# browser. Without these two set, the Church Finder page shows a setup notice
# instead of the search form.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
